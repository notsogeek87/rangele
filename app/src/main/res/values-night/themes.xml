         par la plateforme (poignées de sélection, menus système) suivent le thème de l'app. -->
    <style name="Theme.Rangele" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
